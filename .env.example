# ============================================================
# VARAI — environment
# Copy to .env and fill in.
# ============================================================

PORT=4000
NODE_ENV=development

# ---- DEMO MODE ------------------------------------------------------------
# true  → verdicts are LOCAL PLACEHOLDERS, clearly labelled source:"DEMO",
#         with null transaction and no validator results.
# false → every verdict comes from a real GenLayer execution.
VARAI_DEMO_MODE=true

# ---- Database -------------------------------------------------------------
# Leave blank to use the in-memory store (data lost on restart).
# Postgres:  postgresql://user:pass@localhost:5432/varai
# Supabase:  postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_SSL=false

# Log verbosity: debug | info | warn | error
# Production defaults to info; set debug to log every request.
LOG_LEVEL=debug

# ---- GenLayer -------------------------------------------------------------
# localnet | studionet | testnetAsimov
GENLAYER_NETWORK=studionet

# Optional custom RPC endpoint
GENLAYER_RPC_URL=

# Address printed by `npm run deploy:contract`
GENLAYER_CONTRACT_ADDRESS=

# Backend signing key from `npm run genkey`. Never commit this.
GENLAYER_PRIVATE_KEY=

# Optional — used to build a verification link for the transaction
GENLAYER_EXPLORER_BASE=

GENLAYER_WAIT_RETRIES=100
GENLAYER_WAIT_INTERVAL_MS=5000

# ---- Security -------------------------------------------------------------
MAX_DESCRIPTION_LENGTH=4000
MAX_EVIDENCE_ITEMS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CORS_ORIGIN=*
